# Server
# Cổng chạy API backend
PORT=3000

# MongoDB
# Chuỗi kết nối MongoDB (Atlas/local). Không commit thông tin thật.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# Tên database sử dụng trong cụm MongoDB
MONGO_DB_NAME=apartment-management

# JWT
# Khóa bí mật để ký token đăng nhập
JWT_SECRET=replace-with-a-strong-secret
# Thời gian sống token (vd: 7d, 24h)
JWT_EXPIRES_IN=7d
